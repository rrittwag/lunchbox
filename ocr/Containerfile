FROM --platform=$TARGETPLATFORM docker.io/library/golang:1.26-alpine AS build

WORKDIR /build
COPY . .

ARG APP_VERSION=1.0.0
ENV CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH

RUN go build  \
      -ldflags="-s -w -X rori.dev/lunchbox/ocr/app.Version="$APP_VERSION"" \
      -o runapp

# Add non root user
RUN addgroup -S nonroot && adduser -u 1001 -S nonroot -G nonroot -D

FROM docker.io/library/alpine

ARG VERSION
ARG BUILD_DATE
ARG GIT_COMMIT

LABEL maintainer="mail@rori.info" \
      org.opencontainers.image.title="Lunchbox-OCR" \
      org.opencontainers.image.description="OCR-Service für Lunchbox" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.authors="mail@rori.info" \
      org.opencontainers.image.url="https://code.rori.dev/apps/lunchbox" \
      org.opencontainers.image.source="https://code.rori.dev/apps/lunchbox" \
      org.opencontainers.image.documentation="https://code.rori.dev/apps/lunchbox" \
      org.opencontainers.image.vendor="rori" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_COMMIT}"

WORKDIR /

COPY --from=build /etc/passwd /etc/passwd
COPY --from=build /build/runapp /

RUN apk update \
    && apk add --no-cache \
      tesseract-ocr \
      tesseract-ocr-data-deu

USER nonroot

EXPOSE 9292

ENTRYPOINT ["/runapp"]
